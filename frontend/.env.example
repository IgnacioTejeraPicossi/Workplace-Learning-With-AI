# Frontend build-time environment variables (Create React App).
# Copy this file to `frontend/.env` and adjust per environment.
# Only variables prefixed with REACT_APP_ are exposed to the browser bundle.

# --- Backend base URL -------------------------------------------------------
# REACT_APP_API_BASE_URL is the primary name used across the app. A few older
# modules also read REACT_APP_BACKEND_URL, so set BOTH to the same value to be
# safe. In the cloud, set these to the public backend URL (e.g. https://api.example.com).
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000

# --- Firebase Web config ----------------------------------------------------
# NOTE: a Firebase web apiKey is a PUBLIC project identifier, not a secret.
# Access is controlled by Firebase Security Rules and Authorized Domains.
# These overrides let you point the frontend at a different Firebase project
# without editing source. If left blank, the built-in dev defaults are used.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
