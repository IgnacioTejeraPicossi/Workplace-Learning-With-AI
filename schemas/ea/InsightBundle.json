{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InsightBundle",
  "description": "Complete insight bundle for EA Second Brain Agent execution",
  "type": "object",
  "required": ["run_id", "topic", "summary_md", "actions", "callback_url"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this agent run"
    },
    "topic": {
      "type": "string",
      "description": "Main topic of the insight (e.g., 'Kubernetes 1.31 deprecation')"
    },
    "summary_md": {
      "type": "string",
      "description": "Markdown summary explaining why this matters to Norwegian"
    },
    "evidence": {
      "type": "array",
      "description": "Sources and evidence supporting this insight",
      "items": {
        "type": "object",
        "required": ["url", "source"],
        "properties": {
          "url": {"type": "string"},
          "source": {"type": "string"},
          "snippet": {"type": "string"},
          "published_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "portfolio_matches": {
      "type": "array",
      "description": "Norwegian applications/systems affected",
      "items": {
        "type": "object",
        "required": ["id", "name", "score"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "description": "Recommended next steps",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "detail": {"type": "string"},
          "assignee": {"type": "string"},
          "due_date": {"type": "string", "format": "date-time"}
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Executable actions (Jira, Slack, Confluence, Sheets)",
      "items": {
        "type": "object",
        "required": ["type", "payload"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["jira.createIssue", "slack.postMessage", "confluence.updatePage", "sheets.appendRow"]
          },
          "payload": {"type": "object"}
        }
      }
    },
    "callback_url": {
      "type": "string",
      "description": "URL to call back with execution results"
    }
  }
}

