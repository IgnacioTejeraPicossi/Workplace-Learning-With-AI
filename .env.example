OPENAI_API_KEY=My_OPENAPI_Key

# OpenRouter (optional — free :free models; still needs a key, $0 balance is fine)
# Keys start with sk-or-... (an OpenRouter key is rejected for the OpenAI provider).
OPENROUTER_API_KEY=My_OPENROUTER_Key
# Default free model (default: google/gemma-4-31b-it:free)
#OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Ordered comma-separated list tried on a transient 404/429 (default: OPENROUTER_MODEL,
# then poolside/laguna-s-2.1:free, then nvidia/nemotron-3-ultra-550b-a55b:free)
#OPENROUTER_FREE_FALLBACKS=google/gemma-4-31b-it:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free


# AI Gateway Configuration
CLINIC_SAMPLING=0.25
MONGO_URI=mongodb://localhost:27017/app
CHAT_BACKEND=http://localhost:1234/v1/chat/completions
N8N_BRIDGE=http://localhost:8000/api/n8n/trigger

# MongoDB Authentication Configuration
JWT_SECRET=My_JMT_KEY
JWT_REFRESH_SECRET=My_REFRESH_KEY
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
APP_URL=http://localhost:3000
APP_NAME=AI Learning Platform
COOKIE_SECURE=false

# Authentication hardening
# Allow a MOCK user when Firebase is not initialized. Set to "true" ONLY for
# local development. It MUST stay false/unset in staging and production,
# otherwise authentication is effectively disabled (fail-open).
ALLOW_MOCK_AUTH=false

# HMAC signing secret for agent-to-agent communication
# (backend/security/hmac.py and the productivity agent). Use a long, random
# value in production and store it in a secret manager.
HMAC_SECRET=change-me
AGENTOPS_HMAC_SECRET=change-me

# Email Configuration
EMAIL_PROVIDER=dev
SMTP_FROM=noreply@example.com

# Email Configuration
#EMAIL_PROVIDER=smtp
#SMTP_HOST=smtp-mail.outlook.com
#SMTP_PORT=587
#SMTP_USER=your-email@example.com
#SMTP_PASS=your-email-password
#SMTP_FROM=noreply@example.com

# Jira Integration
# NOTE: the "AI learning Jira integration" token was left to expire (~2026-10-10)
# because Jira is not in active use. Before using Jira again, create a new token at
# https://id.atlassian.com/manage-profile/security/api-tokens (open that URL yourself
# rather than clicking a link from an expiry email) and set JIRA_API_TOKEN below
# (and update the n8n/OutSystems Jira credential if that path is used).
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=Atlassian_API_TOKEN
