{
  "name": "B) Humanoid Chain (Plan→Safety→Sim→Judge)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "path": "agentops-humanoid",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": { "responseData": "={{$json}}" }
      },
      "id": "Webhook2",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 340]
    },
    {
      "parameters": {
        "url": "http://HUMANOID_API_BASE/api/humanoid/plan",
        "method": "POST",
        "responseFormat": "json",
        "jsonParameters": true,
        "options": { "timeout": 30000 },
        "bodyParametersJson": "={{ { twin: $json.input.twin, task: $json.input.task, quality_goal: $json.input.quality_goal || 'balanced' } }}"
      },
      "id": "Plan",
      "name": "POST /plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 260]
    },
    {
      "parameters": {
        "url": "http://HUMANOID_API_BASE/api/humanoid/safety-check",
        "method": "POST",
        "responseFormat": "json",
        "jsonParameters": true,
        "options": { "timeout": 20000 },
        "bodyParametersJson": "={{ { twin: $json.input.twin, task: $json.input.task, plan: $json.plan || $json.plan, context: $json.input.context || { e_stop: true, safe_zone_cleared: true, payload_within_limit: true, payload_weight: 3.0 } } }}"
      },
      "id": "Safety",
      "name": "POST /safety-check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [740, 260]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.ok}}", "operation": "isTrue" }
          ]
        }
      },
      "id": "IF_Safety",
      "name": "IF safety.ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 260]
    },
    {
      "parameters": {
        "url": "http://HUMANOID_API_BASE/api/humanoid/simulate",
        "method": "POST",
        "responseFormat": "json",
        "jsonParameters": true,
        "options": { "timeout": 30000 },
        "bodyParametersJson": "={{ { plan: $json.plan || $prevNode[\"POST /plan\"].json.plan } }}"
      },
      "id": "Sim",
      "name": "POST /simulate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1180, 160]
    },
    {
      "parameters": {
        "url": "http://HUMANOID_API_BASE/api/humanoid/judge",
        "method": "POST",
        "responseFormat": "json",
        "jsonParameters": true,
        "options": { "timeout": 20000 },
        "bodyParametersJson": "={{ { plan: $prevNode[\"POST /plan\"].json.plan, sim: $json, safety: $prevNode[\"POST /safety-check\"].json } }}"
      },
      "id": "Judge",
      "name": "POST /judge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1380, 160]
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { status: 'safety_failed' } }];"
      },
      "id": "SafetyFailed",
      "name": "Safety Failed",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1180, 360]
    },
    {
      "parameters": {
        "url": "={{$json.input?.callback_url || \"http://YOUR_BACKEND/api/agentops/callback/FLOW_ID\"}}",
        "options": {
          "headerParametersJson": "={{\n  const crypto = require('crypto');\n  const isFail = $json.status === 'safety_failed';\n  const payload = isFail ? {status:'safety_failed'} : {plan: $prevNode[\"POST /plan\"].json.plan, sim: $prevNode[\"POST /simulate\"]?.json, judge: $prevNode[\"POST /judge\"]?.json, safety: $prevNode[\"POST /safety-check\"].json};\n  const body = JSON.stringify({ run_id: $json.run_id || $prevNode[\"Webhook\"].json.run_id, kind: 'result', payload });\n  const sig = crypto.createHmac('sha256', 'HMAC_SECRET').update(body).digest('hex');\n  return { 'X-Signature': sig, 'Content-Type':'application/json' };\n}}",
          "body": "={{ {\n  run_id: $json.run_id || $prevNode[\"Webhook\"].json.run_id,\n  kind: 'result',\n  payload: $json.status === 'safety_failed' ? {status:'safety_failed'} : {plan: $prevNode[\"POST /plan\"].json.plan, sim: $prevNode[\"POST /simulate\"]?.json, judge: $prevNode[\"POST /judge\"]?.json, safety: $prevNode[\"POST /safety-check\"].json}\n} }}",
          "sendBody": true
        }
      },
      "id": "Callback_Result2",
      "name": "Callback Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1600, 260]
    },
    {
      "parameters": {
        "responseBody": "={{ {ok:true, run_id: $json.run_id || $prevNode[\"Webhook\"].json.run_id} }}",
        "responseCode": 200
      },
      "id": "Respond2",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1820, 260]
    }
  ],
  "connections": {
    "Webhook": { "main": [ [ { "node": "POST /plan", "type": "main", "index": 0 } ] ] },
    "POST /plan": { "main": [ [ { "node": "POST /safety-check", "type": "main", "index": 0 } ] ] },
    "POST /safety-check": { "main": [ [ { "node": "IF safety.ok", "type": "main", "index": 0 } ] ] },
    "IF safety.ok": {
      "main": [
        [ { "node": "POST /simulate", "type": "main", "index": 0 } ],
        [ { "node": "Safety Failed", "type": "main", "index": 0 } ]
      ]
    },
    "POST /simulate": { "main": [ [ { "node": "POST /judge", "type": "main", "index": 0 } ] ] },
    "POST /judge": { "main": [ [ { "node": "Callback Result", "type": "main", "index": 0 } ] ] },
    "Safety Failed": { "main": [ [ { "node": "Callback Result", "type": "main", "index": 0 } ] ] },
    "Callback Result": { "main": [ [ { "node": "Respond to Webhook", "type": "main", "index": 0 } ] ] }
  }
}
